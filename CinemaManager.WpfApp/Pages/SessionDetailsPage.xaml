<Page x:Class="CinemaManager.WpfApp.Pages.SessionDetailsPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Session Details">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <!-- Movie name header -->
            <TextBlock Text="{Binding Session.MovieName}"
                         FontSize="28"
                         FontWeight="Bold"
                         Margin="0,0,0,20"/>

            <!-- Session details fields -->
            <TextBlock FontSize="16" Margin="0,5">
                  <Run Text="Genre: "/><Run Text="{Binding Session.Genre}"/>
            </TextBlock>
            <TextBlock FontSize="16" Margin="0,5">
                  <Run Text="Year: "/><Run Text="{Binding Session.ReleaseYear}"/>
            </TextBlock>
            <TextBlock FontSize="16" Margin="0,5">
                  <Run Text="Start: "/><Run Text="{Binding Session.StartTime,
  StringFormat='{}{0:dd.MM.yyyy HH:mm}'}"/>
            </TextBlock>
            <TextBlock FontSize="16" Margin="0,5">
                  <Run Text="Duration: "/><Run Text="{Binding Session.DurationMinutes}"/><Run
   Text=" min"/>
            </TextBlock>
            <TextBlock FontSize="16" Margin="0,5">
                  <Run Text="End: "/><Run Text="{Binding Session.EndTime,
  StringFormat='{}{0:dd.MM.yyyy HH:mm}'}"/>
            </TextBlock>
            <TextBlock FontSize="16" Margin="0,5">
                  <Run Text="Hall: "/><Run Text="{Binding Session.CinemaHallName}"/>
            </TextBlock>

            <!-- ID fields -->
            <TextBlock FontSize="14" Margin="0,20,0,0" Foreground="Gray">
                  <Run Text="Session ID: "/><Run Text="{Binding Session.Id}"/>
            </TextBlock>
            <TextBlock FontSize="14" Margin="0,5,0,0" Foreground="Gray">
                  <Run Text="Hall ID: "/><Run Text="{Binding Session.CinemaHallId}"/>
            </TextBlock>
        </StackPanel>

        <!-- Back button -->
        <Button Grid.Row="1"
                  Content="Back"
                  Command="{Binding GoBackCommand}"
                  HorizontalAlignment="Left"
                  Padding="10,5"/>
    </Grid>
</Page>